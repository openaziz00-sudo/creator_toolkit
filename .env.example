# ---- TikTok (developers.tiktok.com) ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# must match a Redirect URI registered in your TikTok app (https only)
TIKTOK_REDIRECT_URI=https://your-site.example/callback
# direct = post straight to your profile | inbox = upload as draft to the TikTok app
TIKTOK_MODE=direct
# unaudited apps can only post SELF_ONLY; after audit use PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY=SELF_ONLY

# ---- YouTube ----
YT_CLIENT_SECRET=client_secret.json
# unverified API projects are forced to private; set "public" after audit
YT_PRIVACY=private

# ---- Instagram (Graph API, Business/Creator account) ----
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=v23.0

# ---- General ----
TOOLKIT_TZ=Asia/Muscat
# TOOLKIT_HOME=~/.creator_toolkit


